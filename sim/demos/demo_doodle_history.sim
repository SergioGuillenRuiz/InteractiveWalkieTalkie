# Demo: un dibujo recibido NO interrumpe; va al Historial como un mensaje mas.
# Se abre desde alli (pulsando A sobre el registro "[dibujo]") y se ve el dibujo.
wait 300
settime 79380
doodle 50
run 400
# (no se muestra a pantalla completa; seguimos en el menu principal)
pot 512
wait 200
tap morse
wait 300
# abrir el registro "[dibujo]" (idx 0) con A
in 0 morse down
in 200 morse up
run 700
shot demo_doodle_history
