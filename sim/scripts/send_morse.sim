# ============================================================
#  Crear un mensaje en Morse y enviarlo
#  "E" = . (un punto).  Confirmar+enviar con FINISH largo.
# ============================================================
wait 300

# IDLE -> ENVIAR -> Morse
pot 80
wait 200
tap morse
wait 200
pot 0
wait 200
tap morse
wait 300
expect text Morse

# Punto corto (< 250 ms) -> '.'
tap morse 120
wait 200

# FINISH largo (>=1500 ms) -> confirma 'E' y envia; luego salir con finish
in 0 finish down
in 1700 finish up
in 3000 finish down
in 3120 finish up
run 3700
expect serial Enviando: E
expect sent E
print Morse: '.' -> 'E' enviado y verificado
