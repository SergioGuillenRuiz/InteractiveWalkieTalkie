# ============================================================
#  Historial: recibir mensajes, abrir un mensaje para leerlo
#  completo y borrar otro (vista -> A borra directamente).
# ============================================================
wait 200

lora rx corto
wait 300
lora rx hola que tal amigo espero que leas este texto completo entero
wait 300
expect serial Guardado: corto

# Entrar al historial
pot 512
wait 200
tap morse
wait 300
expect text Historial
expect text corto

# --- BORRAR "corto" (indice 1, el mas antiguo): abrir -> A borra directamente ---
pot 1023
wait 300
in 0 morse down
in 150 morse up
in 600 morse down
in 750 morse up
run 3200
expect serial Borrado
wait 300

# --- LEER el mensaje largo COMPLETO (fix 1) ---
pot 0
wait 300
in 0 morse down
in 150 morse up
run 700
expect text espero
expect text Borrar
shot history_view
print Fix 1 (leer mensaje completo) y borrado verificados
