# ============================================================
#  Tier 2 - Lienzo (doodle 24x24): dibujar y enviar (5o modo de ENVIAR);
#  recibir (va al Historial como un mensaje mas) y verlo abriendo su registro.
#  Editor: pote=fila(Y), pulsar A pinta, mantener B envia. 72 bytes (0x04).
#  (Device_id del sim = 137.)
# ============================================================
wait 300

# --- IDLE -> ENVIAR -> Dibujar (idx4 de 0..4, pot 880) ---
pot 80
wait 200
tap morse
wait 200
expect text Enviar
pot 880
wait 250
expect text Dibujar

# --- Entrar al editor, pintar y ENVIAR (mantener B), todo en un mismo run
#     porque el editor es bloqueante. (El contenido pintado es indiferente.) ---
in 0 morse down        # selecciona "Dibujar" y entra al editor
in 120 morse up
in 700 morse down      # pulsar A (corto): pinta el pixel del cursor
in 820 morse up
in 1400 finish down    # mantener B (>=1500 ms): envia
in 3100 finish up
run 3600
expect serial Dibujo] enviado
print Dibujo: editor (5o modo de Enviar), pinta y envia OK

# --- RX: recibir un dibujo de #50 -> va al Historial (NO interrumpe) ---
wait 400
settime 79380
doodle 50
run 400
expect serial Dibujo] de #50

# --- Verlo: IDLE -> Historial -> abrir el registro "[dibujo]" (idx 0) ---
pot 512
wait 200
tap morse
wait 300
expect text Historial
expect text dibujo
in 0 morse down
in 200 morse up
run 700
expect text De #50
shot doodle_recibido
print Dibujo: recibido al Historial y visible al abrirlo
