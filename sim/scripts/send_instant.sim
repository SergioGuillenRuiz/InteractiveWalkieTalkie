# ============================================================
#  Enviar un mensaje instantaneo y verificar la transmision LoRa
#  (la pantalla "Enviado" permanece >=800 ms antes de seguir)
# ============================================================
wait 300

# IDLE -> ENVIAR
pot 80
wait 200
tap morse
wait 200
expect text Enviar

# elegir "Instant" (sel 1 de 0..4; banda idx1 = raw 205..409)
pot 300
wait 200
tap morse
wait 250

# seleccionar el mensaje "kissy" (indice 3 de 8)
pot 460
wait 250
expect text kissy
shot send_instant_menu

# enviar (pulsar morse) y, tras la ventana minima, salir con finish
in 0 morse down
in 120 morse up
in 1100 finish down
in 1220 finish up
run 1700
expect serial Enviando: kissy
expect sent kissy
print TX LoRa verificado: kissy cifrado y descifrado correctamente
